{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 run_ab.py status)",
      "Bash(python3 run_ab.py status *)",
      "Bash(python3 run_ab.py check *)",
      "Bash(python3 run_ab.py plan *)",
      "Bash(python3 run_ab.py doctor)",
      "Bash(python3 run_ab.py doctor *)",
      "Bash(python3 run_ab.py updates)",
      "Bash(python3 run_ab.py updates *)",
      "Bash(python3 run_ab.py suite * --check)",
      "Bash(python3 run_ab.py --help)",
      "Bash(python3 run_ab.py --version)",
      "Bash(python3 run_ab.py * --help)",
      "Bash(py run_ab.py status)",
      "Bash(py run_ab.py status *)",
      "Bash(py run_ab.py check *)",
      "Bash(py run_ab.py plan *)",
      "Bash(py run_ab.py doctor)",
      "Bash(py run_ab.py doctor *)",
      "Bash(py run_ab.py updates)",
      "Bash(py run_ab.py updates *)",
      "Bash(py run_ab.py suite * --check)",
      "Bash(py run_ab.py --help)",
      "Bash(py run_ab.py --version)",
      "Bash(py run_ab.py * --help)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/run_ab.py\" updates --hook 2>/dev/null || py \"$CLAUDE_PROJECT_DIR/run_ab.py\" updates --hook 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/run_ab.py\" updates --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
